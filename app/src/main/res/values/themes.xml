<resources>
    <style name="Theme.UtilLock" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/navy_950</item>
        <item name="android:navigationBarColor">@color/navy_950</item>
        <item name="android:windowActionModeOverlay">true</item>
    </style>

    <!-- Android 12+ always draws a system splash. Match ink + shield so it handoffs
         into BrandSplashScreen without a purple/launcher “pre-splash” beat. -->
    <style name="Theme.UtilLock.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ink_950</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo_shield</item>
        <item name="windowSplashScreenIconBackgroundColor">@color/ink_950</item>
        <item name="postSplashScreenTheme">@style/Theme.UtilLock</item>
    </style>
</resources>
